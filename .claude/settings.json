{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(make *)",
      "Bash(make)",
      "Bash(arm-none-eabi-*)",
      "Bash(gbafix *)",
      "Bash(/c/devkitPro/*)",
      "Bash(C:\\devkitPro\\*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
